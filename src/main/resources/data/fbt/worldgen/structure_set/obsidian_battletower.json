  "placement": {
    "type": "minecraft:random_spread",
    "salt": 546466855460,
    "spacing": 160,
    "separation": 80,
    // Never within 3 chunks of a tall or deep tower
    "exclusion_zone": { "other_set": "fbt:tall_battletower", "chunk_count": 3 }
  }
}
